@model List<HealthcareCRM.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
}

<div class="page" style="max-width:1080px; margin:0 auto; padding:26px 28px;">
    <div class="page-head" style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:24px; flex-wrap:wrap;">
        <div>
            <h1 style="font-family:'Fraunces',serif; font-style:italic; font-weight:500; font-size:30px; margin:0 0 6px; color:var(--forest);">Appointments</h1>
            <p style="margin:0; color:var(--muted); font-size:13.5px;">Approve and manage patient appointments</p>
        </div>
    </div>

    <div class="panel" style="background:#fff; border:1px solid var(--line); border-radius:16px; overflow:hidden;">
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="border-bottom:1px solid var(--line); text-align:left;">
                    <th style="padding:14px 20px; font-size:12.5px; font-weight:700; color:var(--muted);">Date</th>
                    <th style="padding:14px 20px; font-size:12.5px; font-weight:700; color:var(--muted);">Patient Name</th>
                    <th style="padding:14px 20px; font-size:12.5px; font-weight:700; color:var(--muted);">Patient Phone</th>
                    <th style="padding:14px 20px; font-size:12.5px; font-weight:700; color:var(--muted);">Specialty</th>
                    <th style="padding:14px 20px; font-size:12.5px; font-weight:700; color:var(--muted);">Doctor</th>
                    <th style="padding:14px 20px; font-size:12.5px; font-weight:700; color:var(--muted);">Fee</th>
                    <th style="padding:14px 20px; font-size:12.5px; font-weight:700; color:var(--muted);">Status</th>
                    <th style="padding:14px 20px; font-size:12.5px; font-weight:700; color:var(--muted);">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if(Model == null || !Model.Any())
                {
                    <tr><td colspan="8" style="text-align:center; padding: 40px; color: var(--muted);">No appointments found.</td></tr>
                }
                else
                {
                    foreach(var p in Model)
                    {
                        var statusColor = p.Status == "Approved" ? "var(--forest)" : p.Status == "Pending" ? "var(--amber)" : "var(--muted)";
                        <tr style="border-bottom:1px solid var(--line); transition:background .15s ease;">
                            <td style="padding:14px 20px; font-size:13.5px; font-weight:600; color:var(--ink);">@p.ScheduledAt.ToString("g")</td>
                            <td style="padding:14px 20px; font-size:13.5px;">@p.PatientName</td>
                            <td style="padding:14px 20px; font-size:13.5px;">@p.PatientPhone</td>
                            <td style="padding:14px 20px; font-size:13.5px;">@p.Specialty</td>
                            <td style="padding:14px 20px; font-size:13.5px;">@p.DoctorName</td>
                            <td style="padding:14px 20px; font-size:13.5px; font-weight:600;">@(p.Currency ?? "Rs") @(p.Fee?.ToString("0.00") ?? "0.00")</td>
                            <td style="padding:14px 20px; font-size:13.5px; font-weight:600; color:@statusColor;">@p.Status</td>
                            <td style="padding:14px 20px;">
                                @if(p.Status == "Pending")
                                {
                                    <form method="post" style="display:inline;" action="/Appointment/Approve">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" style="background:var(--forest); color:white; border:none; padding:6px 12px; border-radius:6px; cursor:pointer; font-size:12px;">Approve</button>
                                    </form>
                                    <form method="post" style="display:inline;" action="/Appointment/Cancel">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" style="background:#e5e7eb; color:#374151; border:none; padding:6px 12px; border-radius:6px; cursor:pointer; font-size:12px; margin-left:6px;">Cancel</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
